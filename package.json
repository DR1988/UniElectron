{
  "name": "electron-with-express",
  "version": "1.0.1",
  "description": "Electron application with express",
  "main": "./app/main.prod.js",
  "scripts": {
    "build-main": "cross-env PORT=8000 NODE_ENV=production webpack --config ./app/config/webpack.config.main.prod.babel.js --colors",
    "build-render": "cross-env NODE_ENV=production webpack --config ./app/config/webpack.config.renderer.prod.babel.js --colors",
    "generate-main-prod": "cross-env NODE_ENV=production node -r @babel/register buildMainProd.js",
    "build-main-pack": "npm run build-main && npm run pack",
    "build": "npm run build-render && npm run generate-main-prod && npm run build-main-pack",
    "start": "cross-env PORT=8000 NODE_ENV=development ts-node -r @babel/register ./app/start.ts",
    "main-dev": "cross-env PORT=8000 NODE_ENV=development electron --openssl-legacy-provider --no-experimental-strip-types -r babel-register-ts ./app/main-dev.js --no-sandbox",
    "fix": "eslint . --ext .js,.jsx --fix",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "create-component": "ts-node -r @babel/register app/helpers/generators/component"
  },
  "keywords": [
    "Electron"
  ],
  "build": {
    "appId": "electron.starter",
    "productName": "ElectronReact",
    "publish": {
      "provider": "github",
      "owner": "DR1988",
      "repo": "UniElectron"
    },
    "toolsets": {
      "appimage": "1.0.3"
    },
    "mac": {
      "category": "your.app.category.type"
    },
    "files": [
      "app/build",
      "app/main.prod.js",
      "app/main.prod.js.map",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "maintainer": "rahmanovdu@gmail.com"
    },
    "directories": {
      "buildResources": "app/resources",
      "output": "release"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DR1988/ElectronReactTsExpress"
  },
  "overrides": {
    "istextorbinary": "9.5.0"
  },
  "author": "DR1988",
  "devDependencies": {
    "@babel/core": "^7.14.0",
    "@babel/plugin-proposal-class-properties": "^7.13.0",
    "@babel/plugin-proposal-object-rest-spread": "^7.13.8",
    "@babel/preset-env": "^7.14.0",
    "@babel/preset-react": "^7.13.13",
    "@babel/preset-typescript": "^7.13.0",
    "@babel/register": "^7.13.16",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.17",
    "@types/classnames": "^2.2.7",
    "@types/express": "^4.16.1",
    "@types/http-server": "^0.10.0",
    "@types/lodash": "^4.17.0",
    "@types/node": "10.12.21",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/socket.io": "^2.1.2",
    "@types/socket.io-client": "^1.4.32",
    "@types/webpack-env": "^1.13.7",
    "awesome-typescript-loader": "^5.2.1",
    "babel-eslint": "^10.0.1",
    "babel-loader": "^8.0.5",
    "babel-register-ts": "^7.0.0",
    "classnames": "^2.2.6",
    "core-js": "^3.11.2",
    "cross-env": "^5.2.0",
    "css-loader": "^2.1.0",
    "electron": "45.0.0",
    "electron-builder": "^26.0.0",
    "electron-devtools-installer": "^2.2.4",
    "electron-react-devtools": "^0.5.3",
    "eslint": "^5.13.0",
    "eslint-config-airbnb": "^17.1.0",
    "eslint-loader": "^2.1.2",
    "eslint-plugin-import": "^2.16.0",
    "eslint-plugin-jsx-a11y": "^6.2.1",
    "eslint-plugin-react": "^7.12.4",
    "file-loader": "^3.0.1",
    "mini-css-extract-plugin": "^0.5.0",
    "node-gyp": "^12",
    "prettier": "3.3.3",
    "react-refresh": "^0.14.2",
    "style-loader": "^0.23.1",
    "terser-webpack-plugin": "^1.2.2",
    "ts-node": "^8.0.2",
    "typescript": "^5.9.3",
    "webpack": "^4.47.0",
    "webpack-cli": "^3.2.3",
    "webpack-dev-middleware": "^3.5.2",
    "webpack-dev-server": "^3.1.14",
    "webpack-hot-middleware": "^2.24.3"
  },
  "dependencies": {
    "@types/react-draft-wysiwyg": "^1.13.4",
    "draft-js": "^0.11.7",
    "electron-dl": "^1.14.0",
    "electron-updater": "^6.8.11",
    "express": "^4.16.4",
    "moment": "^2.30.1",
    "node-hid": "^3.4.0",
    "normalize.css": "^8.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-draft-wysiwyg": "^1.15.0",
    "recharts": "^2.15.4",
    "serialport": "^13.0.0",
    "socket.io": "^2.2.0",
    "socket.io-client": "^2.2.0"
  },
  "allowScripts": {
    "node-hid@3.4.0": true,
    "@serialport/bindings-cpp@13.0.0": true,
    "core-js@3.11.2": true
  }
}
